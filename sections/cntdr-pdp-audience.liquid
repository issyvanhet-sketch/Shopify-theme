<section id="{{ section.id }}" class="cntdr cntdr-pdp-audience">
  <div class="cntdr-wrap cntdr-pdp-ruled">
    <div class="cntdr-pdp-head">
      <div class="cntdr-pdp-head__group">
        <div class="cntdr-eyebrow">{{ section.settings.label }}</div>
        <h2 class="cntdr-h2 cntdr-pdp-head__heading">{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="cntdr-pdp-audience__grid">
      {%- for block in section.blocks -%}
        <div class="cntdr-pdp-persona" {{ block.shopify_attributes }}>
          <div class="cntdr-pdp-persona__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: loading: 'lazy', widths: '300,450,600,900', alt: block.settings.image.alt | default: block.settings.title
              }}
            {%- endif -%}
          </div>
          <div class="cntdr-eyebrow">{{ block.settings.label }}</div>
          <h3 class="cntdr-h4">{{ block.settings.title }}</h3>
          <p class="cntdr-pdp-persona__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CNTDR AM audience",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label",
      "default": "Who it's for"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for people whose first hours decide the day"
    }
  ],
  "blocks": [
    {
      "type": "persona",
      "name": "Persona",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (4:3)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Eyebrow",
          "default": "Founders"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Deep work before the inbox opens"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Clear head for the two hours that move the company."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CNTDR AM audience",
      "blocks": [
        {
          "type": "persona",
          "settings": {
            "label": "Founders",
            "title": "Deep work before the inbox opens",
            "text": "Clear head for the two hours that move the company. No second coffee, no 11 a.m. slump."
          }
        },
        {
          "type": "persona",
          "settings": {
            "label": "Athletes",
            "title": "Train fasted, train hard",
            "text": "Creatine, electrolytes and caffeine in one dose before the session. Same output at 6 a.m. as at 6 p.m."
          }
        },
        {
          "type": "persona",
          "settings": {
            "label": "Operators",
            "title": "Back-to-back without the drift",
            "text": "Steady focus through a full calendar. Sachets travel, so the protocol holds on the road."
          }
        }
      ]
    }
  ]
}
{% endschema %}
