<section id="routine" class="cntdr cntdr-routine">
  <div class="cntdr-wrap cntdr-routine__grid">
    <div class="cntdr-routine__intro">
      <div class="cntdr-eyebrow">{{ section.settings.label }}</div>
      <h2 class="cntdr-h2 cntdr-routine__heading">{{ section.settings.heading }}</h2>
      <p class="cntdr-body-text cntdr-routine__body">{{ section.settings.body }}</p>
      {%- if section.settings.image != blank -%}
        <div class="cntdr-routine__media">
          {{
            section.settings.image
            | image_url: width: 800
            | image_tag: loading: 'lazy', widths: '400,600,800', alt: section.settings.image.alt
          }}
        </div>
      {%- endif -%}
    </div>

    <div class="cntdr-routine__list">
      {%- for block in section.blocks -%}
        <div
          class="cntdr-routine__row{% if block.settings.highlight %} cntdr-routine__row--highlight{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="cntdr-routine__time">{{ block.settings.time }}</div>
          <div>
            <h4 class="cntdr-h4">{{ block.settings.title }}</h4>
            <div class="cntdr-routine__note">{{ block.settings.note }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CNTDR AM routine",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label",
      "default": "The first 180 minutes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for disciplined routines"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>One protocol. No excuses. Drop the sachet in 300 ml of cold water within 15 minutes of waking — everything after that is momentum.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Routine step",
      "settings": [
        {
          "type": "text",
          "id": "time",
          "label": "Time",
          "default": "05:40"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Up"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "No phone. Light on, curtains open."
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight this step",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CNTDR AM routine",
      "blocks": [
        { "type": "step", "settings": { "time": "05:40", "title": "Up", "note": "No phone. Light on, curtains open." } },
        {
          "type": "step",
          "settings": {
            "time": "05:45",
            "title": "CNTDR AM",
            "note": "One sachet, 300 ml cold water. Ten seconds of stirring, that's the whole ritual.",
            "highlight": true
          }
        },
        {
          "type": "step",
          "settings": {
            "time": "06:05",
            "title": "Train",
            "note": "Caffeine and tyrosine peak. Run, lift, or row — hydration already handled."
          }
        },
        {
          "type": "step",
          "settings": {
            "time": "07:20",
            "title": "Cold shower, coffee",
            "note": "Optional. Most people find they need less of it."
          }
        },
        {
          "type": "step",
          "settings": {
            "time": "08:00",
            "title": "Deep work",
            "note": "Citicoline and creatine carry the first block. Hardest task first, no notifications."
          }
        },
        {
          "type": "step",
          "settings": {
            "time": "11:00",
            "title": "Still flat, no crash",
            "note": "Taurine and electrolytes keep the curve level into the afternoon."
          }
        }
      ]
    }
  ]
}
{% endschema %}
