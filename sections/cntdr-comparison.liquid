<section id="formula" class="cntdr cntdr-comparison">
  <div class="cntdr-wrap cntdr-comparison__grid">
    <div class="cntdr-comparison__col">
      <div class="cntdr-eyebrow">{{ section.settings.label }}</div>
      <h2 class="cntdr-h2 cntdr-comparison__heading">{{ section.settings.heading }}</h2>

      <div class="cntdr-comparison__table">
        <div class="cntdr-comparison__row cntdr-comparison__row--head">
          <span>{{ section.settings.column_label }}</span>
          <span style="text-align: center;">CNTDR</span>
          <span style="text-align: right;">{{ section.settings.price_column_label }}</span>
        </div>

        {%- for block in section.blocks -%}
          <div class="cntdr-comparison__row cntdr-comparison__row--body" {{ block.shopify_attributes }}>
            <span class="cntdr-comparison__item">{{ block.settings.item }}</span>
            <span class="cntdr-comparison__check" aria-hidden="true">&#10003;</span>
            <span class="cntdr-comparison__price">{{ block.settings.price }}</span>
          </div>
        {%- endfor -%}

        <div class="cntdr-comparison__row cntdr-comparison__row--total">
          <span class="cntdr-comparison__total-label">{{ section.settings.total_label }}</span>
          <span class="cntdr-comparison__price">{{ section.settings.total_price }}</span>
          <span class="cntdr-comparison__price--strike">{{ section.settings.total_strike_price }}</span>
        </div>
      </div>

      {%- if section.settings.note != blank -%}
        <p class="cntdr-comparison__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    <div class="cntdr-comparison__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', alt: section.settings.image.alt
        }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CNTDR AM comparison",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label",
      "default": "Less clutter. More output."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One protocol replaces the shelf"
    },
    {
      "type": "text",
      "id": "column_label",
      "label": "Left column label",
      "default": "What it replaces"
    },
    {
      "type": "text",
      "id": "price_column_label",
      "label": "Price column label",
      "default": "Per month"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total row label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "total_price",
      "label": "Total price (CNTDR)",
      "default": "$69"
    },
    {
      "type": "text",
      "id": "total_strike_price",
      "label": "Total price (replaced, struck through)",
      "default": "$109"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Closing note",
      "default": "<p>Six actives, one dose, measured for you. No jars, no scoops, no guessing what you already took.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Macro image"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "item",
          "label": "Item replaced",
          "default": "Creatine tub"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price per month",
          "default": "$22"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CNTDR AM comparison",
      "blocks": [
        { "type": "row", "settings": { "item": "Creatine tub", "price": "$22" } },
        { "type": "row", "settings": { "item": "Nootropic stack", "price": "$34" } },
        { "type": "row", "settings": { "item": "Electrolyte sticks", "price": "$19" } },
        { "type": "row", "settings": { "item": "Caffeine + Taurine", "price": "$16" } },
        { "type": "row", "settings": { "item": "Choline capsules", "price": "$18" } }
      ]
    }
  ]
}
{% endschema %}
