{%- liquid
  assign heading_block = section.blocks | where: 'type', 'heading' | first
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'

  assign section_width = 'vso-icon-benefits-container'
  assign blocks_alignment = section.settings.blocks_alignment
  assign desktop_blocks_gap = section.settings.desktop_blocks_gap | default: 32
  assign mobile_blocks_gap = section.settings.mobile_blocks_gap | default: 16
  assign block_padding = section.settings.block_padding | default: 24
  assign block_elements_gap = section.settings.block_elements_gap | default: 16

  assign text_alignment = 'center'
  assign header_elements_gap = 16
  assign header_blocks_gap = 50

  assign heading_title = ''
  assign heading_subtitle = ''
  assign heading_title_highlight_color = '#FACD56'

  if heading_block != blank
    assign text_alignment = heading_block.settings.content_alignment | default: 'center'
    assign header_elements_gap = heading_block.settings.header_elements_gap | default: 16
    assign header_blocks_gap = heading_block.settings.header_blocks_gap | default: 50
    assign heading_title = heading_block.settings.title
    assign heading_subtitle = heading_block.settings.subtitle
    assign heading_title_highlight_color = heading_block.settings.title_highlight_color | default: '#FACD56'
  endif

  assign hero_blocks_classes = "vso-icon-benefits-01__blocks"

  assign title_parts = heading_title | split: '_'
  assign processed_title = ''
  assign is_highlighted = false
  for part in title_parts
    if is_highlighted
      capture highlighted_part
        echo '<span style="color: ' | append: heading_title_highlight_color | append: ';">' | append: part | append: '</span>'
      endcapture
      assign processed_title = processed_title | append: highlighted_part
      assign is_highlighted = false
    else
      assign processed_title = processed_title | append: part
      assign is_highlighted = true
    endif
  endfor

  assign block_count = benefit_blocks.size
  assign mobile_columns = section.settings.mobile_columns | default: '1'
-%}

{%- style -%}
  .vd-l { display: none !important; }
  {% if heading_block != blank and heading_block.settings.custom_title_font %}
    {{ heading_block.settings.title_font | font_face: font_display: 'swap' }}
  {% endif %}
  {% if heading_block != blank and heading_block.settings.custom_subtitle_font %}
    {{ heading_block.settings.subtitle_font | font_face: font_display: 'swap' }}
  {% endif %}
  {{ section.settings.blocks_title_font | font_face: font_display: 'swap' }}
  {{ section.settings.blocks_text_font | font_face: font_display: 'swap' }}

  {% if heading_block != blank and heading_block.settings.custom_title_font %}
    #Icon-Benefits-01-{{ section.id }} .vso-icon-benefits-01__title {
      font-family: {{ heading_block.settings.title_font.family }}, {{ heading_block.settings.title_font.fallback_families }};
      font-style: {{ heading_block.settings.title_font.style }};
    }
  {% endif %}

  {% if heading_block != blank and heading_block.settings.custom_subtitle_font %}
    #Icon-Benefits-01-{{ section.id }} .vso-icon-benefits-01__subtitle {
      font-family: {{ heading_block.settings.subtitle_font.family }}, {{ heading_block.settings.subtitle_font.fallback_families }};
      font-style: {{ heading_block.settings.subtitle_font.style }};
    }
  {% endif %}

  {% if section.settings.custom_blocks_title_font %}
    #Icon-Benefits-01-{{ section.id }} .vso-icon-benefits-01__block-title {
      font-family: {{ section.settings.blocks_title_font.family }}, {{ section.settings.blocks_title_font.fallback_families }};
      font-style: {{ section.settings.blocks_title_font.style }};
    }
  {% endif %}

  {% if section.settings.custom_blocks_text_font %}
    #Icon-Benefits-01-{{ section.id }} .vso-icon-benefits-01__block-text {
      font-family: {{ section.settings.blocks_text_font.family }}, {{ section.settings.blocks_text_font.fallback_families }};
      font-style: {{ section.settings.blocks_text_font.style }};
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-icon-benefits-01 {
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .vso-icon-benefits-01__title {
    margin: 0;
  }

  {% if heading_block != blank and heading_block.settings.custom_title_font %}
    #shopify-section-{{ section.id }} .vso-icon-benefits-01__title {
      line-height: {{ heading_block.settings.title_line_height }}%;
      font-size: {{ heading_block.settings.title_size_mobile }}px;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-icon-benefits-01__title {
        font-size: {{ heading_block.settings.title_size_desktop }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-icon-benefits-01__subtitle {
    margin: 0;
  }

  {% if heading_block != blank and heading_block.settings.custom_subtitle_font %}
    #shopify-section-{{ section.id }} .vso-icon-benefits-01__subtitle {
      line-height: {{ heading_block.settings.subtitle_line_height }}%;
      font-size: {{ heading_block.settings.subtitle_size_mobile }}px;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-icon-benefits-01__subtitle {
        font-size: {{ heading_block.settings.subtitle_size_desktop }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-icon-benefits-01__header {
    display: flex;
    flex-direction: column;
    gap: {{ header_elements_gap }}px;
    margin-bottom: {{ header_blocks_gap }}px;
  }

  #shopify-section-{{ section.id }} .vso-icon-benefits-01__blocks {
    display: grid;
    grid-template-columns: repeat({{ block_count }}, 1fr);
    gap: {{ desktop_blocks_gap }}px;
  }

  #shopify-section-{{ section.id }} .vso-icon-benefits-01__block {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: {{ block_padding }}px;
    background-color: {{ section.settings.block_background_color }};
    border-radius: {{ section.settings.block_border_radius }}px;
    gap: {{ block_elements_gap }}px;
  }

  #shopify-section-{{ section.id }} .vso-icon-benefits-01__block-icon {
    display: flex;
    justify-content: {{ blocks_alignment }};
    line-height: 1;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .vso-icon-benefits-01__block-icon > img {
    width: {{ section.settings.desktop_icon_size }}px;
    height: {{ section.settings.desktop_icon_size }}px;
  }

  #shopify-section-{{ section.id }} .vso-icon-benefits-01__block-title {
    width: 100%;
    margin: 0;
  }

  {% if section.settings.custom_blocks_title_font %}
    #shopify-section-{{ section.id }} .vso-icon-benefits-01__block-title {
      line-height: {{ section.settings.block_title_line_height }}%;
      font-size: {{ section.settings.block_title_size_mobile }}px;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-icon-benefits-01__block-title {
        font-size: {{ section.settings.block_title_size_desktop }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-icon-benefits-01__block-text {
    width: 100%;
    margin: 0;
  }

  {% if section.settings.custom_blocks_text_font %}
    #shopify-section-{{ section.id }} .vso-icon-benefits-01__block-text {
      line-height: {{ section.settings.block_text_line_height }}%;
      font-size: {{ section.settings.block_text_size_mobile }}px;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-icon-benefits-01__block-text {
        font-size: {{ section.settings.block_text_size_desktop }}px;
      }
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .vso-icon-benefits-01__blocks {
      display: grid;
      grid-template-columns: repeat({{ mobile_columns }}, 1fr);
      gap: {{ mobile_blocks_gap }}px;
    }

    #shopify-section-{{ section.id }} .vso-icon-benefits-01__block-icon > img {
      width: {{ section.settings.mobile_icon_size }}px;
      height: {{ section.settings.mobile_icon_size }}px;
    }

    #shopify-section-{{ section.id }} .vso-icon-benefits-01__title {
      {% if heading_block != blank and heading_block.settings.custom_title_font %}
        font-size: {{ heading_block.settings.title_size_mobile }}px;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .vso-icon-benefits-01__subtitle {
      {% if heading_block != blank and heading_block.settings.custom_subtitle_font %}
        font-size: {{ heading_block.settings.subtitle_size_mobile }}px;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .vso-icon-benefits-01__block-title {
      {% if section.settings.custom_blocks_title_font %}
        font-size: {{ section.settings.block_title_size_mobile }}px;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .vso-icon-benefits-01__block-text {
      {% if section.settings.custom_blocks_text_font %}
        font-size: {{ section.settings.block_text_size_mobile }}px;
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} {
    --section-horizontal-padding: var(--page-margin, 16px);
    --section-border-radius: {{ section.settings.section_border_radius_mobile }}px;
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    border-radius: var(--section-border-radius);
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.background_color }};
    }
  }

  {% if section.settings.enable_advanced_settings %}
    #shopify-section-{{ section.id }} {
      --section-horizontal-padding: {{ section.settings.padding_horizontal_mobile }}px;
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --section-horizontal-padding: 0px;
      --section-border-radius: {{ section.settings.section_border_radius }}px;
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
      {% if section.settings.full_width %}
        background-color: {{ section.settings.background_color }};
      {% endif %}
    }
  }

  {% if section.settings.enable_advanced_settings == false and section.settings.full_width %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-container-max-width: var(--page-content-width, var(--page-width, 1440px));
        --section-outer-gutter: max(0px, calc((100vw - var(--section-container-max-width)) / 2));
        --section-horizontal-padding: max(0px, calc(var(--page-margin, 40px) - var(--section-outer-gutter)));
      }
    }
  {% endif %}

  {% if section.settings.enable_advanced_settings == false and section.settings.full_width == false %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: 40px;
      }
    }
  {% endif %}

  {% if section.settings.enable_advanced_settings %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: {{ section.settings.section_horizontal_padding }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} > .vso-icon-benefits-01__container {
    margin-left: auto;
    margin-right: auto;
    max-width: var(--page-content-width, var(--page-width, 1440px));
    {% if section.settings.enable_advanced_settings %}
      max-width: {{ section.settings.section_max_width }}rem;
    {% endif %}
    border-radius: var(--section-border-radius);
    overflow: hidden;
    padding-left: var(--section-horizontal-padding);
    padding-right: var(--section-horizontal-padding);
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} > .vso-icon-benefits-01__container {
      background: transparent;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} > .vso-icon-benefits-01__container {
      {% if section.settings.full_width %}
        background: transparent;
      {% else %}
        background-color: {{ section.settings.background_color }};
        width: calc(100% - (2 * var(--page-margin, 40px)));
      {% endif %}
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .vso-node { display: none; }
  .vso-node--v2 { display: block; }
{%- endstyle -%}

<div class="vso-icon-benefits-01__container vd-l">
  <div class="{{ section_width }}">
    <div class="vso-icon-benefits-01" id="Icon-Benefits-01-{{ section.id }}">
      {% if heading_block != blank %}
        {% if heading_block.settings.title != blank or heading_block.settings.subtitle != blank %}
          <div class="vso-icon-benefits-01__header">
            {% if heading_block.settings.title != blank %}
              {%- assign title_tag = heading_block.settings.title_as | default: 'h2' -%}
              <{{ title_tag }} class="vso-icon-benefits-01__title" style="color: {{ heading_block.settings.title_color }}; text-align: {{ text_alignment }};">
              {{ processed_title }}
              </{{ title_tag }}>
            {% endif %}

            {% if heading_block.settings.subtitle != blank %}
              {%- assign subtitle_tag = heading_block.settings.subtitle_as | default: 'p' -%}
              <{{ subtitle_tag }} class="vso-icon-benefits-01__subtitle" style="color: {{ heading_block.settings.subtitle_color }}; text-align: {{ text_alignment }};">
                {{ heading_block.settings.subtitle }}
              </{{ subtitle_tag }}>
            {% endif %}
          </div>
        {% endif %}
      {% endif %}

      {% if benefit_blocks.size > 0 %}
        <div class="{{ hero_blocks_classes }}">
          {% for block in benefit_blocks %}
            <div class="vso-icon-benefits-01__block" style="text-align: {{ blocks_alignment }};" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <div class="vso-icon-benefits-01__block-icon">
                  {{ block.settings.icon | image_url: width: section.settings.desktop_icon_size | image_tag: loading: 'lazy', width: section.settings.desktop_icon_size, height: section.settings.desktop_icon_size }}
                </div>
              {% endif %}

              {% if block.settings.title != blank %}
                {%- assign blocks_title_tag = section.settings.blocks_title_as | default: 'h3' -%}
                <{{ blocks_title_tag }} class="vso-icon-benefits-01__block-title" style="color: {{ section.settings.blocks_title_color }}; text-align: {{ blocks_alignment }};">
                  {{ block.settings.title }}
                </{{ blocks_title_tag }}>
              {% endif %}

              {% if block.settings.text != blank %}
                {%- assign blocks_text_tag = section.settings.blocks_text_as | default: 'p' -%}
                <{{ blocks_text_tag }} class="vso-icon-benefits-01__block-text" style="color: {{ section.settings.blocks_text_color }}; text-align: {{ blocks_alignment }};">
                  {{ block.settings.text }}
                </{{ blocks_text_tag }}>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "VSO - Icon Benefits 01",
  "tag": "section",
  "class": "section vso-node vso-node--v2 vso-icon-benefits-01",
  "settings": [
    { "type": "header", "content": "Section Settings" },
    {
      "type": "checkbox",
      "id": "enable_advanced_settings",
      "label": "Enable advanced settings",
      "default": false,
      "info": "Shows additional settings for spacing, layout, and typography."
    },
    {
      "type": "range",
      "id": "section_max_width",
      "min": 30,
      "max": 200,
      "step": 2,
      "unit": "rem",
      "label": "Content max width",
      "default": 64,
      "info": "Maximum width of the section content on desktop",
      "visible_if": "{{ section.settings.enable_advanced_settings == true }}"
    },
    {
      "type": "range",
      "id": "section_horizontal_padding",
      "label": "Desktop side spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "info": "Adds spacing on the left and right sides of this section on desktop.",
      "visible_if": "{{ section.settings.enable_advanced_settings == true }}"
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Mobile side spacing",
      "default": 15,
      "info": "Adds spacing on the left and right sides of this section on mobile.",
      "visible_if": "{{ section.settings.enable_advanced_settings == true }}"
    },

    { "type": "header", "content": "Section Background" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#F7F7F7"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width on desktop",
      "default": true,
      "info": "Make section background full width on desktop"
    },
    {
      "type": "range",
      "id": "section_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Desktop border radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "section_border_radius_mobile",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Mobile border radius",
      "default": 0
    },

    { "type": "header", "content": "Section Padding" },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Desktop padding bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile padding bottom",
      "default": 32
    },

    { "type": "header", "content": "Section Margin" },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop margin bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile margin bottom",
      "default": 0
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2",
      "info": "Choose how many benefits per row on mobile"
    },
    {
      "type": "select",
      "id": "blocks_alignment",
      "label": "Benefit content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Layout Settings", "visible_if": "{{ section.settings.enable_advanced_settings == true }}" },
    {
      "type": "range",
      "id": "desktop_blocks_gap",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop benefits gap",
      "default": 32,
      "info": "Space between benefits in desktop view",
      "visible_if": "{{ section.settings.enable_advanced_settings == true }}"
    },
    {
      "type": "range",
      "id": "mobile_blocks_gap",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Mobile benefits gap",
      "default": 16,
      "info": "Space between benefits in mobile view",
      "visible_if": "{{ section.settings.enable_advanced_settings == true }}"
    },

    { "type": "header", "content": "Benefit title typography" },
    {
      "type": "checkbox",
      "id": "custom_blocks_title_font",
      "label": "Enable custom font settings",
      "default": false
    },
    {
      "type": "select",
      "id": "blocks_title_as",
      "label": "Render as",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "p", "label": "Paragraph (p)" }
      ],
      "default": "h3",
      "visible_if": "{{ section.settings.custom_blocks_title_font == false }}"
    },
    {
      "type": "font_picker",
      "id": "blocks_title_font",
      "label": "Font family",
      "default": "helvetica_n4",
      "visible_if": "{{ section.settings.custom_blocks_title_font }}"
    },
    {
      "type": "range",
      "id": "block_title_size_desktop",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Desktop font size",
      "default": 18,
      "visible_if": "{{ section.settings.custom_blocks_title_font }}"
    },
    {
      "type": "range",
      "id": "block_title_size_mobile",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Mobile font size",
      "default": 18,
      "visible_if": "{{ section.settings.custom_blocks_title_font }}"
    },
    {
      "type": "range",
      "id": "block_title_line_height",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Benefit title line height",
      "default": 120,
      "visible_if": "{{ section.settings.custom_blocks_title_font }}"
    },
    {
      "type": "color",
      "id": "blocks_title_color",
      "label": "Benefit title color",
      "default": "#000000"
    },

    { "type": "header", "content": "Benefit text typography" },
    {
      "type": "checkbox",
      "id": "custom_blocks_text_font",
      "label": "Enable custom font settings",
      "default": false
    },
    {
      "type": "select",
      "id": "blocks_text_as",
      "label": "Render as",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "p", "label": "Paragraph (p)" }
      ],
      "default": "p",
      "visible_if": "{{ section.settings.custom_blocks_text_font == false }}"
    },
