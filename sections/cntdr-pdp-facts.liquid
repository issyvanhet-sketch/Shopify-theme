{%- liquid
  assign logo_count = 0
  for block in section.blocks
    if block.type == 'logo' and block.settings.image != blank
      assign logo_count = logo_count | plus: 1
    endif
  endfor
-%}

<section id="facts" class="cntdr cntdr-pdp-facts">
  <div class="cntdr-wrap cntdr-pdp-facts__grid">
    <div class="cntdr-pdp-facts__intro">
      <div class="cntdr-eyebrow">{{ section.settings.label }}</div>
      <h2 class="cntdr-h2 cntdr-pdp-facts__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="cntdr-body-text">{{ section.settings.body }}</p>
      {%- endif -%}

      <div class="cntdr-pdp-facts__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag: loading: 'lazy', widths: '400,600,800,1000', alt: section.settings.image.alt | default: section.settings.heading
          }}
        {%- endif -%}
      </div>

      {%- if logo_count > 0 -%}
        <div class="cntdr-pdp-facts__logos-label">{{ section.settings.logos_label }}</div>
        <div class="cntdr-pdp-facts__logos">
          {%- for block in section.blocks -%}
            {%- if block.type == 'logo' and block.settings.image != blank -%}
              <div class="cntdr-pdp-facts__logo" {{ block.shopify_attributes }}>
                {{
                  block.settings.image
                  | image_url: width: 300
                  | image_tag: loading: 'lazy', widths: '150,300', alt: block.settings.image.alt
                }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="cntdr-pdp-facts__card">
      <div class="cntdr-pdp-facts__card-head">
        <span class="cntdr-h4">{{ section.settings.table_title }}</span>
        <span class="cntdr-pdp-facts__serving">{{ section.settings.table_subtitle }}</span>
      </div>
      <table class="cntdr-pdp-facts__table">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.col_active }}</th>
            <th scope="col">{{ section.settings.col_amount }}</th>
            <th scope="col">{{ section.settings.col_ri }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.active }}</th>
                <td>{{ block.settings.amount }}</td>
                <td>{{ block.settings.ri | default: '—' }}</td>
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
      {%- if section.settings.footnote != blank -%}
        <p class="cntdr-pdp-facts__footnote">{{ section.settings.footnote }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CNTDR AM supplement facts",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label",
      "default": "Full disclosure"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Supplement facts, nothing hidden"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "No proprietary blends, no pixie-dusted actives. Every gram is printed on the box and verified per batch."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Label or certificate image"
    },
    {
      "type": "text",
      "id": "logos_label",
      "label": "Logos label",
      "default": "Tested & certified by"
    },
    {
      "type": "header",
      "content": "Facts table"
    },
    {
      "type": "text",
      "id": "table_title",
      "label": "Table title",
      "default": "Per sachet"
    },
    {
      "type": "text",
      "id": "table_subtitle",
      "label": "Serving line",
      "default": "9.2 g · 30 per box"
    },
    {
      "type": "text",
      "id": "col_active",
      "label": "Column 1",
      "default": "Active"
    },
    {
      "type": "text",
      "id": "col_amount",
      "label": "Column 2",
      "default": "Amount"
    },
    {
      "type": "text",
      "id": "col_ri",
      "label": "Column 3",
      "default": "% RI"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "Other ingredients: natural citrus flavour, malic acid, steviol glycosides. No sugar, no dyes, no maltodextrin. % RI = reference intake for an average adult; — where none is established."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Facts row",
      "settings": [
        {
          "type": "text",
          "id": "active",
          "label": "Active",
          "default": "Creatine Monohydrate"
        },
        {
          "type": "text",
          "id": "amount",
          "label": "Amount",
          "default": "5 g"
        },
        {
          "type": "text",
          "id": "ri",
          "label": "% RI",
          "info": "Leave blank to show —."
        }
      ]
    },
    {
      "type": "logo",
      "name": "Certification logo",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CNTDR AM supplement facts",
      "blocks": [
        { "type": "row", "settings": { "active": "Creatine Monohydrate", "amount": "5 g" } },
        { "type": "row", "settings": { "active": "L-Tyrosine", "amount": "1.5 g" } },
        { "type": "row", "settings": { "active": "Taurine", "amount": "1 g" } },
        { "type": "row", "settings": { "active": "Citicoline (CDP-Choline)", "amount": "250 mg" } },
        { "type": "row", "settings": { "active": "Caffeine (anhydrous)", "amount": "100 mg" } },
        { "type": "row", "settings": { "active": "Sodium (as citrate)", "amount": "600 mg" } },
        { "type": "row", "settings": { "active": "Potassium (as citrate)", "amount": "400 mg", "ri": "20%" } },
        { "type": "row", "settings": { "active": "Magnesium (as citrate)", "amount": "375 mg", "ri": "100%" } }
      ]
    }
  ]
}
{% endschema %}
